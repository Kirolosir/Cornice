            <title>0.4.0</title>
            <pubDate>Sat, 17 Oct 2026 15:58:38 -0400</pubDate>
            <sparkle:version>55</sparkle:version>
            <sparkle:shortVersionString>0.4.0</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
            <description>&lt;h2&gt;Cornice 0.4.0&lt;/h2&gt;&lt;p&gt;Added optional setup, signed in-app updates, music recovery, work/break focus sessions, saved timer presets and quiet completion.&lt;/p&gt;&lt;p&gt;Timers and focus sessions restore after relaunch. System now shows memory pressure and reported battery condition. Keyboard controls and Reduce Motion behavior have also been improved.&lt;/p&gt;&lt;p&gt;Keyboard: Control-Option-Command-D to toggle the panel, Command-1/2/3 to switch panels, Escape to close.&lt;/p&gt;</description>
            <enclosure url="https://github.com/Kirolosir/Cornice/releases/download/v0.4.0/Cornice-0.4.0.zip" length="3960582" type="application/octet-stream" sparkle:edSignature="wugT1tMjWxNNcIXsBCKMTubovdtTCJibqDqr9c8mmFXqYafy76LYXspie9VMpuU5QSBYx5bw2INRGLvMxn31DA=="></enclosure>
